{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "composite": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["electron"]
}
